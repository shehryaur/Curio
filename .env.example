# Copy this file to .env.local and paste your keys after the "=" (no quotes).
# .env.local is git-ignored; never commit real keys.

# k-ID: secret key (starts kgs_test_), shown in Kai next to the publishable key. Server only.
KID_SECRET_KEY=
KID_API_HOST=https://kai-api.test.k-id.com

# Gemini: object recognition + lesson generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash        # optional

# Inworld: the owl's voice (TTS)
INWORLD_API_KEY=                      # paste the Base64 key from the portal as-is
INWORLD_VOICE_ID=Ashley               # optional
INWORLD_TTS_MODEL=inworld-tts-2       # optional

# Modulate: voice input, emotion detection, PII redaction
MODULATE_API_KEY=

# Meshy: optional stretch (wildcard 3D models)
MESHY_API_KEY=
MESHY_AI_MODEL=                       # optional
